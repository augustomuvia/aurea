# ---------------------------------------------------------------
# AUREA — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel.
# Nunca coloque valores reais neste ficheiro.
# ---------------------------------------------------------------

# URL pública da aplicação (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas servidor. Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=
# A integração Supabase da Vercel pode usar os nomes novos; ambos são aceites:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (em vez da anon) e SUPABASE_SECRET_KEY (em vez da service role).

# Primeiro super admin (usado por `npm run admin:bootstrap`)
SUPER_ADMIN_EMAIL=

# Exigir autenticação multifator (TOTP) no painel /admin
ADMIN_REQUIRE_MFA=true

# Segredo para o cron da Vercel (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# E-mails automáticos via Google Workspace (Gmail API, OAuth 2.0). Apenas servidor.
# Sem estas variáveis, a integração fica "por configurar" e nada é enviado nem simulado.
# Passo a passo em docs/NOTIFICACOES.md. Nunca use a palavra-passe da conta.
EMAIL_PROVIDER=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# O remetente, o nome "AUREA | Suporte" e o e-mail administrativo configuram-se no painel (/admin/notificacoes).
# Os e-mails de autenticação (confirmação de conta, recuperação) continuam a ser enviados pelo Supabase.

# ---------------------------------------------------------------
# Pagamentos — Multicaixa Express
# PAYMENT_MODE=manual_review → modo provisório (confirmação pelo admin com evidência).
# PAYMENT_MODE=partner → só depois de implementar o adaptador com a especificação
# oficial do parceiro e testar o fluxo real.
# ---------------------------------------------------------------
PAYMENT_MODE=manual_review
# Segredo partilhado para verificar assinaturas HMAC dos webhooks do parceiro
PAYMENT_WEBHOOK_SECRET=

# Página do e-book (/ebook): domínios autorizados para o URL de checkout, separados por vírgula.
# Ex.: EBOOK_CHECKOUT_ALLOWED_HOSTS=kursinha.com  (aceita também subdomínios). Vazio = qualquer domínio https válido.
EBOOK_CHECKOUT_ALLOWED_HOSTS=

# Kursinha (vendas → acesso premium). Ver docs/KURSINHA.md.
# Preferível: o "Secret" do webhook na Kursinha (mín. 16 caracteres) — verifica X-Webhook-Signature.
KURSINHA_WEBHOOK_SECRET=
# Alternativa quando o painel não permite Secret: token longo (mín. 32) no URL ?token=…  Ignorado se houver SECRET.
KURSINHA_WEBHOOK_TOKEN=
# Opcional: IDs de produto Kursinha que dão acesso, separados por vírgulas. Vazio = decide só o preço do plano.
KURSINHA_PRODUCT_IDS=
# Domínios aceites no "Link de checkout" dos planos (Admin → Planos). Por omissão: kursinha.com (e subdomínios).
PLAN_CHECKOUT_ALLOWED_HOSTS=kursinha.com

# ---------------------------------------------------------------
# AUREA — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel.
# Nunca coloque valores reais neste ficheiro.
# ---------------------------------------------------------------

# URL pública da aplicação (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas servidor. Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=
# A integração Supabase da Vercel pode usar os nomes novos; ambos são aceites:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (em vez da anon) e SUPABASE_SECRET_KEY (em vez da service role).

# Primeiro super admin (usado por `npm run admin:bootstrap`)
SUPER_ADMIN_EMAIL=

# Exigir autenticação multifator (TOTP) no painel /admin
ADMIN_REQUIRE_MFA=true

# Segredo para o cron da Vercel (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# E-mail transacional (opcional). Sem chave, os e-mails da app não são enviados.
# Os e-mails de autenticação são enviados pelo Supabase (configure SMTP no Supabase).
RESEND_API_KEY=
EMAIL_FROM="AUREA <nao-responder@seu-dominio>"

# ---------------------------------------------------------------
# Pagamentos — Multicaixa Express
# PAYMENT_MODE=manual_review → modo provisório (confirmação pelo admin com evidência).
# PAYMENT_MODE=partner → só depois de implementar o adaptador com a especificação
# oficial do parceiro e testar o fluxo real.
# ---------------------------------------------------------------
PAYMENT_MODE=manual_review
# Segredo partilhado para verificar assinaturas HMAC dos webhooks do parceiro
PAYMENT_WEBHOOK_SECRET=

# Página do e-book (/ebook): domínios autorizados para o URL de checkout, separados por vírgula.
# Ex.: EBOOK_CHECKOUT_ALLOWED_HOSTS=kursinha.com  (aceita também subdomínios). Vazio = qualquer domínio https válido.
EBOOK_CHECKOUT_ALLOWED_HOSTS=
